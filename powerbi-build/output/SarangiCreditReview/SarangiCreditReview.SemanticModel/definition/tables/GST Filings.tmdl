/// GSTR1/GSTR3B filing details. Delay recomputed from supplied due and filing dates, floored at zero; source delay retained. Late fee amounts are not supplied.
table 'GST Filings'
	lineageTag: 79bff081-4cd1-4022-b644-e5ea8e0de803

	/// Filings Reviewed
	measure 'Filings Reviewed' = COUNTROWS('GST Filings')
		formatString: #,0
		displayFolder: Compliance
		lineageTag: 1aa43f91-9f24-4d48-8352-80ea3a97163e

	/// Late Filings
	measure 'Late Filings' = COUNTROWS(FILTER('GST Filings','GST Filings'[Delay Days]>0))
		formatString: #,0
		displayFolder: Compliance
		lineageTag: ed6269ab-52f7-4707-9cdc-750bca000cd3

	/// Late Filing Share
	measure 'Late Filing Share' = DIVIDE([Late Filings],[Filings Reviewed])
		formatString: 0.0%
		displayFolder: Compliance
		lineageTag: 3af834df-0b48-4b5a-8744-d6978db84d4f

	/// Maximum Filing Delay
	measure 'Maximum Filing Delay' = MAX('GST Filings'[Delay Days])
		formatString: 0 "days"
		displayFolder: Compliance
		lineageTag: 7e8870d3-7996-4544-992c-aa2394844f07

	/// Average Filing Delay
	measure 'Average Filing Delay' = AVERAGE('GST Filings'[Delay Days])
		formatString: 0.0 "days"
		displayFolder: Compliance
		lineageTag: 3128953d-5e7a-4e17-b134-773c31317bc7

	column Month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 3bf67659-4781-4e9e-a8f6-4934f5144a4a
		summarizeBy: none
		sourceColumn: Month

		annotation UnderlyingDateTimeDataType = Date

	column GSTIN
		dataType: string
		lineageTag: 9528b760-b84f-48f4-a68f-4aa14bc29a62
		summarizeBy: none
		sourceColumn: GSTIN

	column State
		dataType: string
		lineageTag: b66e353b-86e9-44cb-a91c-6664d6b3b7a7
		summarizeBy: none
		sourceColumn: State

	column Return
		dataType: string
		lineageTag: 46b6f197-bfb4-4b1d-ac62-2fcf61b23260
		summarizeBy: none
		sourceColumn: Return

	column 'Due Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: e835ee56-02d3-4dad-b190-0094cd8d542a
		summarizeBy: none
		sourceColumn: Due Date

		variation Variation
			isDefault
			relationship: a2c0ff21-3e8e-417a-925a-571cec68d8f0
			defaultHierarchy: LocalDateTable_ec38411a-ea3a-4439-a4a6-2ab3bafce156.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Filing Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: aa0909ca-542d-40da-b9e2-3f557261e9bb
		summarizeBy: none
		sourceColumn: Filing Date

		variation Variation
			isDefault
			relationship: 12506a57-f071-4fb0-9473-c948bc49bf60
			defaultHierarchy: LocalDateTable_0914043a-a4ab-423b-8ac7-ad526d059abb.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Delay Days'
		dataType: double
		lineageTag: 7cf3ec6d-7b7f-4af6-9a3e-69581feb0cd0
		summarizeBy: sum
		sourceColumn: Delay Days

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Source Delay Days'
		dataType: double
		lineageTag: faff0b5a-5878-431a-b3f8-5b936c39e15b
