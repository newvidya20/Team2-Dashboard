/// Consolidated MoM Summary only. Dashes are missing/not reported, not imputed zero. BTO is source-reported net credits, with gross credits available separately.
table 'Bank Monthly'
	lineageTag: 6f51ec28-90a7-48c7-8a62-ededc0912ff4

	/// Consolidated MoM Summary: Net Credits. Blank means not reported.
	measure 'Banking Turnover' = SUM('Bank Monthly'[Net Credits])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: 6aae4093-a242-46a8-837c-f6f7bae28719

	/// Consolidated MoM Summary: Net Debits. Blank means not reported.
	measure 'Net Bank Outflows' = SUM('Bank Monthly'[Net Debits])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: d1f9a7f4-6f02-4d5c-a872-05ffffeac428

	/// Consolidated MoM Summary: Net Credit Count. Blank means not reported.
	measure 'Net Credit Entries' = SUM('Bank Monthly'[Net Credit Count])
		formatString: #,0
		displayFolder: Banking
		lineageTag: 69583b0c-8c65-4d75-9aaa-1ec0bd8f83c7

	/// Consolidated MoM Summary: Inward Bounce Count. Blank means not reported.
	measure 'Cheque Return Count' = SUM('Bank Monthly'[Inward Bounce Count])
		formatString: #,0
		displayFolder: Banking
		lineageTag: 83825641-a985-43b4-ac79-68f5e8c7aab2

	/// Consolidated MoM Summary: Inward Bounce Amount. Blank means not reported.
	measure 'Cheque Return Amount' = SUM('Bank Monthly'[Inward Bounce Amount])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: 542a9f07-38ea-474a-83b8-023f20275706

	/// Consolidated MoM Summary: EMI Bounce Count. Blank means not reported.
	measure 'EMI Return Count' = SUM('Bank Monthly'[EMI Bounce Count])
		formatString: #,0
		displayFolder: Banking
		lineageTag: 2f9fa2e6-53c1-479b-b92f-e34dec59af4d

	/// Consolidated MoM Summary: Interest Paid. Blank means not reported.
	measure 'Bank Interest Paid' = SUM('Bank Monthly'[Interest Paid])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: 97ac2f96-9d7a-4c7a-b4e2-f79beb3d53d3

