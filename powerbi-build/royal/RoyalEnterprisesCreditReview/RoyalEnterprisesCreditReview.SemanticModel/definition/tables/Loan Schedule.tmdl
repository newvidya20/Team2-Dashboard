/// Source obligation sheet as of 7 July 2026. Row EMI sum INR5687124 vs printed INR5445112; difference INR242012 equals Siemens EMI. Monthly EMI is not annual principal repayment; amounts are not substituted into historical DSCR.
table 'Loan Schedule'
	lineageTag: ed0ad955-19e4-4c26-a405-521c241004a6

	/// Monthly EMI Lakh
	measure 'Monthly EMI Lakh' = DIVIDE(SUM('Loan Schedule'[Monthly EMI]),100000)
		formatString: #,0.00
		lineageTag: f45a596a-842e-4a63-9769-4f7fd3250757

	column No
		dataType: int64
		formatString: #,0
		lineageTag: d8f10285-acf3-4dd7-9aa0-661afe1f4182
		summarizeBy: none
		sourceColumn: No

	column Lender
		dataType: string
		lineageTag: 0c8062e9-9d29-430d-9670-e18ee18f1f63
		summarizeBy: none
		sourceColumn: Lender

	column 'Loan Type'
		dataType: string
		lineageTag: 854d85d8-be69-4b35-8d50-78a6ba7a1e32
		summarizeBy: none
		sourceColumn: Loan Type

	column Security
		dataType: string
		lineageTag: f7fa3725-0601-4058-9079-fcab5dff95f0
		summarizeBy: none
		sourceColumn: Security

	column Sanctioned
		dataType: double
		formatString: #,0.00
		lineageTag: d42d9561-e1ea-4170-b9fd-2c3aff63652e
		summarizeBy: none
		sourceColumn: Sanctioned

	column Disbursed
		dataType: double
		formatString: #,0.00
		lineageTag: 6d287a86-dca9-4a41-b3f2-36b254c6376e
		summarizeBy: none
		sourceColumn: Disbursed

	column 'Disbursement Date'
		dataType: string
		lineageTag: fc2a4a5a-e180-4801-8334-5baba956ed91
		summarizeBy: none
		sourceColumn: Disbursement Date

	column 'Interest Rate'
		dataType: double
		formatString: 0.00%
		lineageTag: 31246b44-1d48-4d70-88f5-b9ee4a262b7a
		summarizeBy: none
		sourceColumn: Interest Rate

	column 'Tenure Months'
		dataType: int64
		formatString: #,0
		lineageTag: 3813d19c-0762-4f72-8bfb-800bad638bca
		summarizeBy: none
		sourceColumn: Tenure Months

	column 'Monthly EMI'
		dataType: double
		formatString: #,0.00
		lineageTag: fb3ce7b8-1d23-4cbb-b7d1-6f3a04e5d5d5
		summarizeBy: none
		sourceColumn: Monthly EMI

	partition 'Loan Schedule' = m
		mode: import
		source = let R=Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.GZip)), T=Table.FromRows(R,{"No","Lender","Loan Type","Security","Sanctioned","Disbursed","Disbursement Date","Interest Rate","Tenure Months","Monthly EMI"}), X=Table.TransformColumnTypes(T,{{"No", Int64.Type},{"Lender", type text},{"Loan Type", type text},{"Security", type text},{"Sanctioned", type number},{"Disbursed", type number},{"Disbursement Date", type text},{"Interest Rate", type number},{"Tenure Months", Int64.Type},{"Monthly EMI", type number}}) in X

