/// GSTR-3B section 3.1 values. Zero-rated supplies are not independently verified export turnover. ARN date used as filing evidence; no statutory due date assumed.
table 'GST Monthly'
	lineageTag: 1213d00d-acc1-4569-bf8a-7737bcb1e5b7

	/// GST Sales Cr
	measure 'GST Sales Cr' = DIVIDE(SUM('GST Monthly'[Total Outward Supplies]),10000000)
		formatString: #,0.00
		lineageTag: f433f2fe-df03-41c7-b493-f151697bf6e3

	/// Taxable Sales Cr
	measure 'Taxable Sales Cr' = DIVIDE(SUM('GST Monthly'[Taxable Sales]),10000000)
		formatString: #,0.00
		lineageTag: 6c1de6be-974d-4405-af0c-4c26b6ec98e8

	/// Exempt Sales Cr
	measure 'Exempt Sales Cr' = DIVIDE(SUM('GST Monthly'[Exempt Sales]),10000000)
		formatString: #,0.00
		lineageTag: eee0bdad-9df9-4635-aee4-4f1ab7964bf3

	/// Zero Rated Cr
	measure 'Zero Rated Cr' = DIVIDE(SUM('GST Monthly'[Zero Rated Sales]),10000000)
		formatString: #,0.00
		lineageTag: 72e8f253-66b1-455e-894a-22e7e452730e

	/// GST Late Fee
	measure 'GST Late Fee' = SUM('GST Monthly'[Late Fee])
		formatString: ₹ #,0.00
		lineageTag: 2d5ac177-d871-43b6-95bf-8a973328e349

	/// GST Filings
	measure 'GST Filings' = COUNTROWS('GST Monthly')
		formatString: 0
		lineageTag: f7751fb9-9cf5-41cb-877e-70d9b1fa715c

	/// Zero Rated Share
	measure 'Zero Rated Share' = DIVIDE([Zero Rated Cr],[GST Sales Cr])
		formatString: 0.00%
		lineageTag: 2f58c4b5-aa9f-4197-8e90-1c6a1ae13053

