/// Proprietorship accounts. Reported profit is before proprietor income tax; no corporate PAT asserted. Debt includes friend/relative borrowing. Current ratio uses explicitly classified current liabilities, without assumed current maturities. COGS is opening inventory + purchases - closing inventory (labour/freight excluded).
table Financials
	lineageTag: 40f99837-0014-4c81-9875-f3c3d6c3f673

	/// Finance Sales Cr
	measure 'Finance Sales Cr' = DIVIDE(SUM('Financials'[Sales]),10000000)
		formatString: #,0.00
		lineageTag: 941fbaad-3333-4b09-bd54-0cc64eb20cf2

	/// Finance Profit Cr
	measure 'Finance Profit Cr' = DIVIDE(SUM('Financials'[Reported Profit Before Owner Tax]),10000000)
		formatString: #,0.00
		lineageTag: c077d0e0-767e-4c7d-8ae6-2c6fc2ba6363

	/// Finance EBITDA Cr
	measure 'Finance EBITDA Cr' = DIVIDE(SUM('Financials'[EBITDA]),10000000)
		formatString: #,0.00
		lineageTag: 25b3989d-743a-4860-997b-cabc9f9cd74e

	/// Finance Capital Cr
	measure 'Finance Capital Cr' = DIVIDE(SUM('Financials'[Proprietor Capital]),10000000)
		formatString: #,0.00
		lineageTag: 765bf960-ab02-410f-90d0-82fc868408c4

	/// Finance Debt Cr
	measure 'Finance Debt Cr' = DIVIDE(SUM('Financials'[Total Debt]),10000000)
		formatString: #,0.00
		lineageTag: 56a6de95-7dcd-46a3-bf2a-4657a712042c

	/// Finance Debtors Cr
	measure 'Finance Debtors Cr' = DIVIDE(SUM('Financials'[Debtors]),10000000)
		formatString: #,0.00
		lineageTag: 3bd6272b-d7cd-4007-8609-778eedf37680

	/// Debt Equity
	measure 'Debt Equity' = DIVIDE(SUM('Financials'[Total Debt]),SUM('Financials'[Proprietor Capital]))
		formatString: 0.00"x"
		lineageTag: bc4fb2b8-0f65-410b-aab9-c9243b179c56

	/// Current Ratio
	measure 'Current Ratio' = DIVIDE(SUM('Financials'[Current Assets]),SUM('Financials'[Reported Current Liabilities]))
		formatString: 0.00"x"
		lineageTag: 12fc1122-d9c2-46b8-a8f7-028a1a67e848

	/// Interest Cover
	measure 'Interest Cover' = DIVIDE(SUM('Financials'[EBIT]),SUM('Financials'[Interest]))
		formatString: 0.00"x"
		lineageTag: 826c2bb7-d767-48e3-b906-5c978a593d35

	/// Reported Margin
	measure 'Reported Margin' = DIVIDE(SUM('Financials'[Reported Profit Before Owner Tax]),SUM('Financials'[Sales]))
		formatString: 0.00%
		lineageTag: f77a2eb9-11f8-44a5-8370-4728bfe7e5c1

	column 'Financial Year'
