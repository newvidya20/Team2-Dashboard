	partition 'Bank Transactions' = m
		mode: import
		source = let R=Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.GZip)), T=Table.FromRows(R,{"Date","Month","Bank","Sequence","Party","Narration","Debit","Credit","Balance","Internal Match","Return Type","Cash Deposit","Penal Charges","Loan Credit Candidate","BTO Eligible","Source","Page"}), X=Table.TransformColumnTypes(T,{{"Date", type text},{"Month", type text},{"Bank", type text},{"Sequence", Int64.Type},{"Party", type text},{"Narration", type text},{"Debit", type number},{"Credit", type number},{"Balance", type number},{"Internal Match", type text},{"Return Type", type text},{"Cash Deposit", type number},{"Penal Charges", type number},{"Loan Credit Candidate", type number},{"BTO Eligible", type number},{"Source", type text},{"Page", Int64.Type}}) in X

