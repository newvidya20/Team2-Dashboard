/// Original statement transactions, excluding opening balances. All consecutive running balances reconcile. Parties retain narration spelling; no fuzzy merges. Classifications are narration-based candidates unless reciprocal internal transfer confirmed.
table 'Bank Transactions'
	lineageTag: 1b72bbf2-f6b9-4096-8578-47a9e78a9a88

	/// Bank Credits Cr
	measure 'Bank Credits Cr' = DIVIDE(SUM('Bank Transactions'[Credit]),10000000)
		formatString: #,0.00
		lineageTag: 76cb1b90-7f48-4846-b189-3a0a8abf5ee8

	/// Bank Debits Cr
	measure 'Bank Debits Cr' = DIVIDE(SUM('Bank Transactions'[Debit]),10000000)
		formatString: #,0.00
		lineageTag: 550ae117-e52c-4687-bd9c-4ad839089b68

	/// Adjusted BTO Cr
	measure 'Adjusted BTO Cr' = DIVIDE(SUM('Bank Transactions'[BTO Eligible]),10000000)
		formatString: #,0.00
		lineageTag: 8cd6c7cc-d8a4-47f4-bac3-c28adc54014b

	/// Cash Deposits Cr
	measure 'Cash Deposits Cr' = DIVIDE(SUM('Bank Transactions'[Cash Deposit]),10000000)
		formatString: #,0.00
		lineageTag: f50531e7-2c28-48ff-8cff-17b34a773c06

	/// Loan Candidates Cr
	measure 'Loan Candidates Cr' = DIVIDE(SUM('Bank Transactions'[Loan Credit Candidate]),10000000)
		formatString: #,0.00
		lineageTag: 5650c5c9-8053-4d16-b641-c7d3369f0f3d

	/// Credit Entries
	measure 'Credit Entries' = COUNTROWS(FILTER('Bank Transactions','Bank Transactions'[Credit]>0))
		formatString: #,0
		lineageTag: 8d6206ec-58d3-4da5-8305-0e2d0be2e6e8

	/// Return Candidates
	measure 'Return Candidates' = COUNTROWS(FILTER('Bank Transactions','Bank Transactions'[Return Type]<>"No return marker"))
		formatString: #,0
		lineageTag: b06f6ef8-139b-4c27-831d-60aa668ef941

	/// Penal Charge Candidates
	measure 'Penal Charge Candidates' = SUM('Bank Transactions'[Penal Charges])
		formatString: ₹ #,0.00
		lineageTag: de2b7a3d-ca08-4032-a7a7-bbae78a0adfc

	/// Internal Credits Cr
	measure 'Internal Credits Cr' = DIVIDE(CALCULATE(SUM('Bank Transactions'[Credit]),'Bank Transactions'[Internal Match]="Confirmed reciprocal transfer"),10000000)
		formatString: #,0.00
		lineageTag: 69f153d4-79a2-4fba-931f-a5d5adf35f90

