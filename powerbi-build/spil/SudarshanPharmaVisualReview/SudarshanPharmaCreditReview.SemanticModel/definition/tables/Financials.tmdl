/// Standalone figures only, INR base units. FY2024 previous GAAP vs FY2025/26 Ind AS must be read with basis notes. Total debt includes current/noncurrent borrowings plus lease liabilities. Borrowing balances include accrued interest where source does. TNW deducts intangibles. No projected CMA actuals mixed in.
table Financials
	lineageTag: 68265e65-af5d-435a-88ce-92ba4b33b26d

	/// Finance Sales Cr
	measure 'Finance Sales Cr' = DIVIDE(SUM('Financials'[Sales]),10000000)
		formatString: #,0.00
		lineageTag: 4a4d1845-13ba-430a-be1b-0a0d33aa7c82

	/// Finance PAT Cr
	measure 'Finance PAT Cr' = DIVIDE(SUM('Financials'[PAT]),10000000)
		formatString: #,0.00
		lineageTag: bed25ddf-9e6f-4c70-b5bf-0a4ddb4a49b1

	/// Finance EBITDA Cr
	measure 'Finance EBITDA Cr' = DIVIDE(SUM('Financials'[EBITDA]),10000000)
		formatString: #,0.00
		lineageTag: c42d7797-0d5c-4d81-b228-d73d30ee421b

	/// Finance Equity Cr
	measure 'Finance Equity Cr' = DIVIDE(SUM('Financials'[Equity]),10000000)
		formatString: #,0.00
		lineageTag: d084faf2-876f-4844-b0ca-51203db0b0b1

	/// Finance Debt Cr
	measure 'Finance Debt Cr' = DIVIDE(SUM('Financials'[Total Debt]),10000000)
		formatString: #,0.00
		lineageTag: 8c492843-a85a-4e9a-8246-e7f6cca7db00

	/// Finance CFO Cr
	measure 'Finance CFO Cr' = DIVIDE(SUM('Financials'[Operating Cash Flow]),10000000)
		formatString: #,0.00
		lineageTag: 36c867c5-54ea-467a-aa15-7e73d00a4136

	/// Debt Equity
	measure 'Debt Equity' = DIVIDE(SUM('Financials'[Total Debt]),SUM('Financials'[Equity]))
		formatString: 0.00"x"
		lineageTag: 031ded00-ad6c-47f4-81a8-ab04f93b60c1

	/// Current Ratio
	measure 'Current Ratio' = DIVIDE(SUM('Financials'[Current Assets]),SUM('Financials'[Current Liabilities]))
		formatString: 0.00"x"
		lineageTag: 0f88cac7-45ed-40b5-8b80-fd1b0a228d43

	/// Interest Cover
	measure 'Interest Cover' = DIVIDE(SUM('Financials'[EBIT]),SUM('Financials'[Interest]))
		formatString: 0.00"x"
		lineageTag: 2ba529bb-2ed0-4a16-b94b-61663a198730

	/// PAT Margin
	measure 'PAT Margin' = DIVIDE(SUM('Financials'[PAT]),SUM('Financials'[Sales]))
		formatString: 0.00%
		lineageTag: eaeb177f-02a6-4a38-8464-00d8fa062425

