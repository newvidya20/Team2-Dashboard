/// 32 facilities as at 30 June 2026; LC and derivative limits are non-funded exposure, not annual balance sheet debt. Missing EMI remains null. Source printed EMI total sums numeric cells only, excluding text-formatted EMI values.
table 'Loan Schedule'
	lineageTag: f35d11c4-168e-4eeb-9814-a596d2ac6749

	/// Monthly EMI Lakh
	measure 'Monthly EMI Lakh' = DIVIDE(SUM('Loan Schedule'[Monthly EMI]),100000)
		formatString: #,0.00
		lineageTag: e681e83c-9e82-4f92-b19a-aedfcef47056

	column No
		dataType: int64
		formatString: #,0
		lineageTag: 0d7a667a-7f20-4239-8cdc-c78f7186031b
		summarizeBy: none
		sourceColumn: No

	column Lender
		dataType: string
		lineageTag: 8a80d14b-a429-4a4d-a51c-25ff553755bd
		summarizeBy: none
		sourceColumn: Lender

	column Account
		dataType: string
		lineageTag: ebf7c990-da18-4799-b8a5-97edb3f6ed23
		summarizeBy: none
		sourceColumn: Account

	column 'Facility Type'
		dataType: string
		lineageTag: 741e5147-d249-44dc-9e51-518399529ee8
		summarizeBy: none
		sourceColumn: Facility Type

	column Sanctioned
		dataType: double
		formatString: #,0.00
		lineageTag: 9858cdaf-f318-49b5-9376-b688f7064438
		summarizeBy: none
		sourceColumn: Sanctioned

	column 'Monthly EMI'
		dataType: double
		formatString: #,0.00
		lineageTag: 527aebc6-5c3e-443a-9f94-71352ed046a6
		summarizeBy: none
		sourceColumn: Monthly EMI

	column Outstanding
		dataType: double
		formatString: #,0.00
		lineageTag: 5d76ae7b-eabe-41a3-8636-6bc90c09c3ff
		summarizeBy: none
		sourceColumn: Outstanding

	column 'Paid From'
		dataType: string
		lineageTag: 28367260-6170-478b-a588-59d6a9163e3d
		summarizeBy: none
		sourceColumn: Paid From

	partition 'Loan Schedule' = m
		mode: import
		source = let R=Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.GZip)), T=Table.FromRows(R,{"No","Lender","Account","Facility Type","Sanctioned","Monthly EMI","Outstanding","Paid From"}), X=Table.TransformColumnTypes(T,{{"No", Int64.Type},{"Lender", type text},{"Account", type text},{"Facility Type", type text},{"Sanctioned", type number},{"Monthly EMI", type number},{"Outstanding", type number},{"Paid From", type text}}) in X

