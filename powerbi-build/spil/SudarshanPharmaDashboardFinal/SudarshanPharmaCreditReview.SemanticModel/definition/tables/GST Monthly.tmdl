/// 74 GSTR-3B documents across five registrations. Haryana February 2026 has no ARN/date, so filing remains unverified. Telangana starts October 2025 in supplied records; other four start April 2025. Registration-state turnover is not customer-state revenue. Inter-branch taxable supplies may be included; no consolidation elimination is possible from 3B alone.
table 'GST Monthly'
	lineageTag: e3902b98-7fb5-43d4-9963-88cdb2531ffe

	/// GST Sales Cr
	measure 'GST Sales Cr' = DIVIDE(SUM('GST Monthly'[Total Outward Supplies]),10000000)
		formatString: #,0.00
		lineageTag: 90ca5632-5acb-4afb-8d53-4cc6ee78c955

	/// Taxable Sales Cr
	measure 'Taxable Sales Cr' = DIVIDE(SUM('GST Monthly'[Taxable Sales]),10000000)
		formatString: #,0.00
		lineageTag: 83821871-8cde-4e4c-b64e-23689c168908

	/// Exempt Sales Cr
	measure 'Exempt Sales Cr' = DIVIDE(SUM('GST Monthly'[Exempt Sales]),10000000)
		formatString: #,0.00
		lineageTag: 5af28133-2c89-47e4-b963-4a3447ed7a18

	/// Zero Rated Cr
	measure 'Zero Rated Cr' = DIVIDE(SUM('GST Monthly'[Zero Rated Sales]),10000000)
		formatString: #,0.00
		lineageTag: f324f8d5-f4b1-4fe3-ae40-9f5af0e25967

	/// GST Filings
	measure 'GST Filings' = COUNTROWS('GST Monthly')
		formatString: #,0
		lineageTag: ec0478af-3545-48a3-87a5-227fb80544e5

	/// GST Late Fee
	measure 'GST Late Fee' = SUM('GST Monthly'[Late Fee])
		formatString: ₹ #,0.00
		lineageTag: 51f2d29d-4e72-4e42-99fa-58169062edf2

	/// Zero Rated Share
	measure 'Zero Rated Share' = DIVIDE([Zero Rated Cr],[GST Sales Cr])
		formatString: 0.00%
		lineageTag: ae866797-239a-4abc-bbda-4dc039f60d45

