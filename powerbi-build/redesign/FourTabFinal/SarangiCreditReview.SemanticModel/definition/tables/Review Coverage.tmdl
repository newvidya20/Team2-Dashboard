/// Checklist coverage, definitions and evidence gaps. Missing data is not substituted with fabricated values.
table 'Review Coverage'
	lineageTag: f5140ddd-194a-46f9-b9af-0f1f8282fa63

	/// Missing Requirements
	measure 'Missing Requirements' = COUNTROWS(FILTER('Review Coverage','Review Coverage'[Status]="Missing source"))
		formatString: #,0
		displayFolder: Coverage
		lineageTag: 27e8f375-9028-4eee-b2cc-bff1e839395f

	/// Requirements Reviewed
	measure 'Requirements Reviewed' = COUNTROWS('Review Coverage')
		formatString: #,0
		displayFolder: Coverage
		lineageTag: e66106a9-1c08-48aa-97ac-ae627b18b509

	/// Coverage Count
	measure 'Coverage Count' = COUNTROWS('Review Coverage')
		formatString: #,0
		displayFolder: Coverage
		lineageTag: fd1dc06a-2636-4fc0-90a3-12afc60be15d

	column Area
		dataType: string
		lineageTag: 8d6bf445-8959-4145-a2e6-e10b88445bcc
		summarizeBy: none
		sourceColumn: Area

	column Requirement
		dataType: string
		lineageTag: e620b120-2c6d-428b-8cbf-5ec67b8abc6e
		summarizeBy: none
		sourceColumn: Requirement

	column Status
		dataType: string
		lineageTag: f50df182-8ce4-4d78-b86e-ad7770dbfd12
		summarizeBy: none
		sourceColumn: Status

	column 'Evidence or Gap'
		dataType: string
		lineageTag: 1d47814e-e249-4dbb-b224-be550de6aea7
		summarizeBy: none
		sourceColumn: Evidence or Gap

	partition 'Review Coverage' = m
		mode: import
		source =
				let
				  Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				  Data = Table.FromRows(Rows, {"Area","Requirement","Status","Evidence or Gap"}),
				  Typed = Table.TransformColumnTypes(Data, {{"Area", type text},{"Requirement", type text},{"Status", type text},{"Evidence or Gap", type text}}, "en-US")
				in Typed

