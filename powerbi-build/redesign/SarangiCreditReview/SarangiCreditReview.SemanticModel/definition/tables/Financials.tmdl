	/// GST Period
	measure 'GST Period' = VAR A=MIN('GST Monthly'[Month]) VAR B=MAX('GST Monthly'[Month]) RETURN IF(ISBLANK(A),"No GST data in selection",FORMAT(A,"MMM yyyy") & " – " & FORMAT(B,"MMM yyyy"))
		formatString: General
		displayFolder: Credit Review
		lineageTag: 258a1c91-d608-43cb-8a0b-12b06d9664f4

	/// Bank Period
	measure 'Bank Period' = VAR A=MIN('Bank Monthly'[Month]) VAR B=MAX('Bank Monthly'[Month]) RETURN IF(ISBLANK(A),"No banking data in selection",FORMAT(A,"MMM yyyy") & " – " & FORMAT(B,"MMM yyyy"))
		formatString: General
		displayFolder: Credit Review
		lineageTag: 01209f33-f3a6-4e35-9158-c617f7626e97

	/// Top Buyer Cr
	measure 'Top Buyer Cr' = VAR R=RANKX(ALLSELECTED('GST Parties'[Party]),[Buyer Sales],,DESC,DENSE) RETURN IF(R<=6,[Buyer Sales Cr])
		formatString: 0.00
		displayFolder: Credit Review
		lineageTag: c86d282f-5d71-440e-ae98-add0d711e5c5

	/// Top Supplier Cr
	measure 'Top Supplier Cr' = VAR R=RANKX(ALLSELECTED('GST Parties'[Party]),[Supplier Purchases],,DESC,DENSE) RETURN IF(R<=6,[Supplier Purchases Cr])
		formatString: 0.00
		displayFolder: Credit Review
		lineageTag: 74c1dafe-7786-4971-b0c8-9a0ced0b9e52

	/// Top Bank Receipts Cr
	measure 'Top Bank Receipts Cr' = VAR R=RANKX(ALLSELECTED('Bank Transactions'[Party]),[Gross Inflows],,DESC,DENSE) RETURN IF(R<=6,[Bank Inflows Cr])
		formatString: 0.00
		displayFolder: Credit Review
		lineageTag: 5aa533f4-2398-468e-87dd-765891dc4f7b

	/// Source Penal Charges
	measure 'Source Penal Charges' = IF(ISBLANK([Penal Charges]),"Not reported","₹ " & FORMAT([Penal Charges],"#,0.00"))
		formatString: General
		displayFolder: Credit Review
		lineageTag: 70ab56bf-4fba-4cd1-ae2c-146f9c74b066

	/// Return Summary
	measure 'Return Summary' = FORMAT([Cheque Return Count],"0") & " inward returns · ₹" & FORMAT([Cheque Return Amount]/100000,"0.00") & " lakh"
		formatString: General
		displayFolder: Credit Review
		lineageTag: c2238026-9d16-4ada-9979-b5f53fa38c19

	/// EMI Return Display
	measure 'EMI Return Display' = IF(ISBLANK([EMI Return Count]),"Not reported",FORMAT([EMI Return Count],"0"))
		formatString: General
		displayFolder: Credit Review
		lineageTag: 7e5ecf2d-2761-4864-b466-469b966f4c95

	/// Name Match Display
	measure 'Name Match Display' = FORMAT([Name Match Coverage],"0.0%") & " of receipts have an exact GST party name"
		formatString: General
		displayFolder: Credit Review
		lineageTag: 7b6d18ce-a91e-4214-88e7-c2a460fdb4e7

	/// Finance Sales Growth
	measure 'Finance Sales Growth' = VAR Y=VALUE(LEFT([Review Financial Year],4))-1 VAR P=FORMAT(Y,"0000") & "-" & FORMAT(Y+1,"0000") VAR V=CALCULATE(SUM('Financials'[Sales]),REMOVEFILTERS('Financials'),'Financials'[Financial Year]=P) RETURN IF(NOT ISBLANK(V),DIVIDE([FY Sales]-V,V))
		formatString: 0.0%;(0.0%);0.0%
		displayFolder: Credit Review
		lineageTag: aa0a41bd-b7ca-448d-a405-5f8073cc89c4

	/// Tax and PAT Check
	measure 'Tax and PAT Check' = IF(ABS([PAT Check])<0.01,"PAT reconciles to statements","PAT arithmetic needs review")
		formatString: General
		displayFolder: Credit Review
		lineageTag: 79b57e06-5add-4ab3-b79d-a69f5a47d380

	measure 'Finance Header' = "KPI year: " & [Review Financial Year] & "  |  Trends retain all available years"
		formatString: General
		displayFolder: Credit Review
		lineageTag: fc63af28-776b-466e-b304-5c34b3b8f7c9

	measure 'PDF Header' = "Results for FY " & [Review Financial Year] & "  |  Currency results in lakh"
		formatString: General
		displayFolder: Credit Review
		lineageTag: 9417f82c-048d-4486-baf9-15ea66c4769b

