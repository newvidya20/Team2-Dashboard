/// All 25 numbered financial/credit parameters in the supplied credit due diligence PDF; definition caveats and missing evidence are explicit.
table 'Calculation Register'
	lineageTag: ae477e96-86f3-42ce-b266-f7fc5c181483

	/// Calculation Numeric
	measure 'Calculation Numeric' = SWITCH(SELECTEDVALUE('Calculation Register'[No]),1,[EBIT],2,[EBITDA - PDF EBITA],3,[FY Net Profit],4,[EBIT],7,[Current Ratio],8,[Quick Ratio],9,[Debt Equity Ratio],10,[PDF Literal Adjusted Debt Equity],11,[Interest Coverage Ratio],12,[TOL TNW Ratio],13,[Net Profit Margin],14,[Debt EBITDA Ratio],16,[Reserves Equity Proxy],17,[Debtor Days],18,[Creditor Days],19,[Stock Days],20,[Working Capital Ratio])
		formatString: 0.00
		displayFolder: Credit Review
		lineageTag: e4f06ab5-1da7-4308-8be2-b65aa82468c7

	/// Calculation Result
	measure 'Calculation Result' = VAR V=[Calculation Numeric] VAR U=SELECTEDVALUE('Calculation Register'[Unit]) VAR S=SELECTEDVALUE('Calculation Register'[Evidence Status]) RETURN IF(ISBLANK(V),IF(S="Banking tab","See Banking",IF(S="Finance tab","See Finance","Not available")),SWITCH(U,"Currency","₹ " & FORMAT(V/100000,"#,0.00") & " lakh","Percent",FORMAT(V,"0.00%"),"Days",FORMAT(V,"0.0") & " days",FORMAT(V,"0.00") & "x"))
		formatString: General
		displayFolder: Credit Review
		lineageTag: 73024080-8d62-4cff-886a-4569f5a549d8

	/// Calculation Evidence
	measure 'Calculation Evidence' = SELECTEDVALUE('Calculation Register'[Evidence Status])
		formatString: General
		displayFolder: Credit Review
		lineageTag: baa02f54-27fb-4d4f-b6e2-ad45d0da273c

	/// Calculation Color
	measure 'Calculation Color' = SWITCH(SELECTEDVALUE('Calculation Register'[Evidence Status]),"Missing evidence","#B45309","Definition caveat","#A34D22","Proxy only","#A34D22","#117D75")
		formatString: General
		displayFolder: Credit Review
		lineageTag: 43de892d-096c-4e95-85bf-4823bacec5d4

	/// Calculation Count
	measure 'Calculation Count' = COUNTROWS('Calculation Register')
		formatString: 0
		displayFolder: Credit Review
		lineageTag: f5d89b96-d151-4ea4-98af-6a959cc2287b

	/// Calculation Missing
	measure 'Calculation Missing' = CALCULATE(COUNTROWS('Calculation Register'),'Calculation Register'[Evidence Status]="Missing evidence")
		formatString: 0
		displayFolder: Credit Review
		lineageTag: da9a7ff7-3f41-4983-ac97-038a3b2246e1

	measure 'Register Scope' = FORMAT([Calculation Count],"0") & " PDF parameters in view"
		formatString: General
		displayFolder: Credit Review
		lineageTag: 86ce1461-5554-487e-a1e5-e7bbdbb00135

	column No
		dataType: int64
		lineageTag: 13fcf981-cae8-4d9b-8178-fadedaae17a8
		summarizeBy: none
		sourceColumn: No

	column Category
		dataType: string
		lineageTag: 28e24843-2c0f-4947-94bb-4d7b2fdd335c
		summarizeBy: none
		sourceColumn: Category

	column Parameter
		dataType: string
		lineageTag: 807880a2-e6de-46f2-8f5e-7ba8156752f7
		summarizeBy: none
		sourceColumn: Parameter
		sortByColumn: No

	column Formula
		dataType: string
		lineageTag: 266bf88f-e812-46bf-9d10-bc38d33d2017
		summarizeBy: none
		sourceColumn: Formula

	column Metric
		dataType: string
		isHidden
		lineageTag: 40e8e9c1-2209-4d69-8f6e-4f2cdbe7d185
		summarizeBy: none
		sourceColumn: Metric

	column Unit
		dataType: string
		isHidden
		lineageTag: 4dde1ac0-780b-4173-8d1f-29d572b00fcd
		summarizeBy: none
		sourceColumn: Unit

	column 'Evidence Status'
		dataType: string
		lineageTag: fdfff9c3-53e1-4a91-a20d-0bc688e367ae
		summarizeBy: none
		sourceColumn: Evidence Status

	column Interpretation
		dataType: string
		lineageTag: 89ab0f24-33f8-41b3-ab5e-aa8ac94aaea4
		summarizeBy: none
		sourceColumn: Interpretation

	partition 'Calculation Register' = m
		mode: import
		source = let R=Json.Document(Binary.Decompress(Binary.FromText("",BinaryEncoding.Base64),Compression.GZip)), T=Table.FromRows(R,{"No","Category","Parameter","Formula","Metric","Unit","Evidence Status","Interpretation"}), X=Table.TransformColumnTypes(T,{{"No", Int64.Type},{"Category", type text},{"Parameter", type text},{"Formula", type text},{"Metric", type text},{"Unit", type text},{"Evidence Status", type text},{"Interpretation", type text}}) in X

