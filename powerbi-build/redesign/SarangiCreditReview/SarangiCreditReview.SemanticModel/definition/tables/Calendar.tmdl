/// Month-grain calendar; India April-March financial years. Common Period identifies shared GST/bank April-September 2024 coverage.
table Calendar
	lineageTag: c6c8ff93-fc08-4834-acdc-9e2ba0481ef1

	column Month
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: a664994e-872d-48a7-8940-128a839703d7
		summarizeBy: none
		sourceColumn: Month

		variation Variation
			isDefault
			relationship: c00cada5-03b6-4bfe-80dc-87de5db8573c
			defaultHierarchy: LocalDateTable_55b809d4-a4d1-4946-9f0b-70841a228a31.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Month Label'
		dataType: string
		lineageTag: 0481cb9b-99a8-4143-8aac-fbe293382ca0
		summarizeBy: none
		sourceColumn: Month Label
		sortByColumn: 'Month Sort'

	column 'Month Sort'
		dataType: double
		isHidden
		lineageTag: b2776058-f095-4d1e-b4a1-72f170549cb9
		summarizeBy: sum
		sourceColumn: Month Sort

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Financial Year'
		dataType: string
		lineageTag: 4d0b5cab-28f5-454e-bfc1-2eb97dd9ccd2
		summarizeBy: none
		sourceColumn: Financial Year

	column 'Common Period'
		dataType: string
		lineageTag: 0870aeb1-d2a6-4ff9-903c-ecbc0a39125a
		summarizeBy: none
		sourceColumn: Common Period

	partition Calendar = m
		mode: import
		source =
				let
				  Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				  Data = Table.FromRows(Rows, {"Month","Month Label","Month Sort","Financial Year","Common Period"}),
				  Typed = Table.TransformColumnTypes(Data, {{"Month", type nullable date},{"Month Label", type text},{"Month Sort", type nullable number},{"Financial Year", type text},{"Common Period", type text}}, "en-US")
				in Typed

