/// Apr-Sep 2024 only. Exact normalized names (punctuation/spacing/case ignored). GST taxable amounts vs gross bank cash flows incl tax, loans and transfers; variance is NOT an outstanding debtor/creditor balance or proof of mismatch. No GSTIN exists in bank source. Unmatched entries retained.
table 'Party Reconciliation'
	lineageTag: 9cdd1e5d-368e-4d02-973f-899f5183a6bb

	/// Apr-Sep2024 taxable GST values vs gross bank cash; variance is not an outstanding balance.
	measure 'Common GST Sales' = SUM('Party Reconciliation'[GST Sales])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: 4325f68c-53fb-4a75-8c8c-efd10ac80ceb

	/// Apr-Sep2024 taxable GST values vs gross bank cash; variance is not an outstanding balance.
	measure 'Common GST Purchases' = SUM('Party Reconciliation'[GST Purchases])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: 1ec234c8-a4df-467b-81e7-91a1b77a1751

	/// Apr-Sep2024 taxable GST values vs gross bank cash; variance is not an outstanding balance.
	measure 'Common Bank Receipts' = SUM('Party Reconciliation'[Bank Receipts])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: 58561455-7ee5-4bed-aa89-8caa01d8e2a0

	/// Apr-Sep2024 taxable GST values vs gross bank cash; variance is not an outstanding balance.
	measure 'Common Bank Payments' = SUM('Party Reconciliation'[Bank Payments])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: ec7bd78d-90b4-430e-8f95-27e30efba4e3

	/// Apr-Sep2024 taxable GST values vs gross bank cash; variance is not an outstanding balance.
	measure 'Sales Cash Variance' = SUM('Party Reconciliation'[Sales Less Receipts])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: 07be3afd-d598-4b57-8bed-ad4aee9be263

	/// Apr-Sep2024 taxable GST values vs gross bank cash; variance is not an outstanding balance.
	measure 'Purchases Cash Variance' = SUM('Party Reconciliation'[Purchases Less Payments])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: 66f0012c-f849-4ba8-8801-d4671f1b6509

	/// Unmatched Bank Receipts
	measure 'Unmatched Bank Receipts' = CALCULATE([Common Bank Receipts],FILTER('Party Reconciliation','Party Reconciliation'[Match Status]<>"Exact normalized name"))
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: 473de745-bf26-40a4-9033-0633492d0a11

	/// Matched Name Receipts
	measure 'Matched Name Receipts' = CALCULATE([Common Bank Receipts],'Party Reconciliation'[Match Status]="Exact normalized name")
		formatString: #,0.00;(#,0.00);–
		displayFolder: Reconciliation
		lineageTag: d2f0f066-a697-443b-bccb-772a8c0c861e

	/// Name Match Coverage
	measure 'Name Match Coverage' = DIVIDE([Matched Name Receipts],[Common Bank Receipts])
		formatString: 0.0%
		displayFolder: Reconciliation
		lineageTag: 978cfc69-51ca-4f27-ba4d-b31275f60853

	column Month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 5cf3cb06-ee8f-4209-a20c-ac1f15f858d4
		summarizeBy: none
		sourceColumn: Month

		annotation UnderlyingDateTimeDataType = Date

	column Party
