/// Consolidated Raw Data block only; account-level repeats excluded. INR. Source category and counterparty retained; unidentified entries remain unidentified.
table 'Bank Transactions'
	lineageTag: f27f3b80-bc5e-43fc-b725-5a9f4717bf7e

	/// Gross Inflows
	measure 'Gross Inflows' = SUM('Bank Transactions'[Credit])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Banking
		lineageTag: 3d18a870-4efb-48be-9fea-e450479686fe

	/// Gross Outflows
	measure 'Gross Outflows' = SUM('Bank Transactions'[Debit])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Banking
		lineageTag: c8ddbeaa-a8d6-4b09-b05e-7eab84a6a0fd

	/// Net Cash Flow
	measure 'Net Cash Flow' = [Gross Inflows]-[Gross Outflows]
		formatString: #,0.00;(#,0.00);–
		displayFolder: Banking
		lineageTag: e9f8a466-159b-4c41-9d55-e08a30e03f69

	/// Source rows are one-sided; four all-zero rows are explicitly credit entries. All rows except nonzero debit entries; source total 237.
	measure 'Credit Entries' = COUNTROWS('Bank Transactions')-COUNTROWS(FILTER('Bank Transactions','Bank Transactions'[Debit]<>0))
		formatString: #,0
		displayFolder: Banking
		lineageTag: c7f52071-02c1-48e2-b9de-ef90d9ecaf11

	/// Nonzero signed debit entries; all zero-value rows in this source are credit entries. Source total 645.
	measure 'Debit Entries' = COUNTROWS(FILTER('Bank Transactions','Bank Transactions'[Debit]<>0))
		formatString: #,0
		displayFolder: Banking
		lineageTag: 70111b46-821c-493f-b4ca-4b72fbe45475

	/// Transaction Count
	measure 'Transaction Count' = COUNTROWS('Bank Transactions')
		formatString: #,0
		displayFolder: Banking
		lineageTag: f81c1430-b872-43a1-a696-2c68a4978439

	/// Cash Deposits
	measure 'Cash Deposits' = CALCULATE([Gross Inflows],'Bank Transactions'[Category]="Cash Deposit")
		formatString: #,0.00;(#,0.00);–
		displayFolder: Banking
		lineageTag: 84be4671-9a95-45e0-8536-41fd4953f9ed

	/// Unidentified Inflows
	measure 'Unidentified Inflows' = CALCULATE([Gross Inflows],'Bank Transactions'[Party Key]="UNIDENTIFIED")
		formatString: #,0.00;(#,0.00);–
		displayFolder: Banking
		lineageTag: 48ad08a1-55f7-4818-b650-3570a95e2920

	/// Consolidated MoM Summary: Penal Charges. Blank means not reported.
	measure 'Penal Charges' = SUM('Bank Monthly'[Penal Charges])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: 27aa5adb-ba38-4f92-8530-d0eaa92d21de

	/// Consolidated MoM Summary: Loan Disbursements. Blank means not reported.
	measure 'Loan Disbursements' = SUM('Bank Monthly'[Loan Disbursements])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: 241640f0-08df-4502-9b15-9eecb1d52cf7

	/// Consolidated MoM Summary: EMI Payments. Blank means not reported.
	measure 'EMI Payments' = SUM('Bank Monthly'[EMI Payments])
		formatString: #,0.00
		displayFolder: Banking
		lineageTag: 4f1fc57d-307b-4c09-98a8-b9942514b0aa

