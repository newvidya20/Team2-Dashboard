	partition 'Bank Transactions' = m
		mode: import
		source =
				let
				  Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				  Data = Table.FromRows(Rows, {"Transaction ID","Date","Month","Narration","Debit","Credit","Balance","Category","Party","Party Key","Bank","Account","Source Row"}),
				  Typed = Table.TransformColumnTypes(Data, {{"Transaction ID", type nullable number},{"Date", type nullable date},{"Month", type nullable date},{"Narration", type text},{"Debit", type nullable number},{"Credit", type nullable number},{"Balance", type nullable number},{"Category", type text},{"Party", type text},{"Party Key", type text},{"Bank", type text},{"Account", type text},{"Source Row", type nullable number}}, "en-US")
				in Typed

