/// State-wise taxable values. Exports and exempt/nil/non-GST buckets retained by source label. Subtotals excluded.
table 'GST State'
	lineageTag: 4d1a652d-508c-4fab-a849-f642c4ac2f3d

	/// State Revenue
	measure 'State Revenue' = CALCULATE(SUM('GST State'[Amount]),KEEPFILTERS('GST State'[Type]="Revenue"))
		formatString: #,0.00;(#,0.00);–
		displayFolder: GST
		lineageTag: 79ac948c-a342-4b41-bbf3-c4e82d48e9e6

	/// State Purchases
	measure 'State Purchases' = CALCULATE(SUM('GST State'[Amount]),KEEPFILTERS('GST State'[Type]="Purchases"))
		formatString: #,0.00;(#,0.00);–
		displayFolder: GST
		lineageTag: 6a10c0e2-0468-40bc-9333-726bf8573061

	column Month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 58f80077-9061-42d3-8d4f-12395ff77ae9
		summarizeBy: none
		sourceColumn: Month

		annotation UnderlyingDateTimeDataType = Date

	column Type
		dataType: string
		lineageTag: 2593dde2-0fe4-4850-870d-01a69743d955
		summarizeBy: none
		sourceColumn: Type

	column State
		dataType: string
		lineageTag: 18f242f2-6780-45b3-9ddf-5d1c80757d49
		summarizeBy: none
		sourceColumn: State

	column 'State Code'
		dataType: string
		lineageTag: 7bc61d2e-0203-4a10-828a-8061b3625b5e
		summarizeBy: none
		sourceColumn: State Code

	column Amount
		dataType: double
		lineageTag: 37c3263f-c7d6-43dd-8674-1df53e19fee7
		summarizeBy: sum
		sourceColumn: Amount

	partition 'GST State' = m
		mode: import
		source =
				let
				  Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				  Data = Table.FromRows(Rows, {"Month","Type","State","State Code","Amount"}),
				  Typed = Table.TransformColumnTypes(Data, {{"Month", type nullable date},{"Type", type text},{"State", type text},{"State Code", type text},{"Amount", type nullable number}}, "en-US")
				in Typed

