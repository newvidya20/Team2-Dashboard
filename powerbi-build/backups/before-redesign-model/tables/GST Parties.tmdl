/// Nonzero monthly party taxable values. GSTIN-valid detail rows only; totals, annual and TTM columns excluded. Buyer/supplier shares use party totals in selected periods.
table 'GST Parties'
	lineageTag: 86759beb-a816-420b-863b-9319202c68d6

	/// Buyer Sales
	measure 'Buyer Sales' = CALCULATE(SUM('GST Parties'[Amount]),KEEPFILTERS('GST Parties'[Role]="Buyer"))
		formatString: #,0.00;(#,0.00);–
		displayFolder: Counterparties
		lineageTag: fa7a9c46-32a7-4174-a217-2adbd613f27f

	/// Buyer Sales Share
	measure 'Buyer Sales Share' = DIVIDE([Buyer Sales],CALCULATE([Buyer Sales],REMOVEFILTERS('GST Parties'[Party]),REMOVEFILTERS('GST Parties'[GSTIN]),REMOVEFILTERS('GST Parties'[Party Key])))
		formatString: 0.0%
		displayFolder: Counterparties
		lineageTag: b4548b2a-7deb-4ecb-b5ee-3ea5c75168f8

	/// Supplier Purchases
	measure 'Supplier Purchases' = CALCULATE(SUM('GST Parties'[Amount]),KEEPFILTERS('GST Parties'[Role]="Supplier"))
		formatString: #,0.00;(#,0.00);–
		displayFolder: Counterparties
		lineageTag: 8dbf2ed4-e815-4f75-9834-38cc20860f26

	/// Supplier Purchases Share
	measure 'Supplier Purchases Share' = DIVIDE([Supplier Purchases],CALCULATE([Supplier Purchases],REMOVEFILTERS('GST Parties'[Party]),REMOVEFILTERS('GST Parties'[GSTIN]),REMOVEFILTERS('GST Parties'[Party Key])))
		formatString: 0.0%
		displayFolder: Counterparties
		lineageTag: 6c89c436-3736-471c-8059-0c18ab2c1ecb

	/// Party Amount
	measure 'Party Amount' = SUM('GST Parties'[Amount])
		formatString: #,0.00;(#,0.00);–
		displayFolder: Counterparties
		lineageTag: 524e9736-4402-4f85-9539-2b3ca9942893

	/// Share of selected role and time period, removing party identity filters.
	measure 'Party Share' = DIVIDE([Party Amount],CALCULATE([Party Amount],REMOVEFILTERS('GST Parties'[Party]),REMOVEFILTERS('GST Parties'[Party Key]),REMOVEFILTERS('GST Parties'[GSTIN])))
		formatString: 0.0%
		displayFolder: Counterparties
		lineageTag: b65485ef-5ba8-417e-8fc6-fd58ab87f70b

	column Month
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7a004d31-4bee-42b7-9191-d30245c1bd16
		summarizeBy: none
		sourceColumn: Month

		annotation UnderlyingDateTimeDataType = Date

	column Role
		dataType: string
		lineageTag: 4c9e3221-bef8-4069-a2af-adeb9f6aa2d4
		summarizeBy: none
		sourceColumn: Role

	column Party
		dataType: string
		lineageTag: 9b12e52f-363c-4a9b-acc3-7e42a20c78ce
		summarizeBy: none
		sourceColumn: Party

	column 'Party Key'
		dataType: string
		lineageTag: e2052548-0d72-48ae-88a1-03a4ede2e510
		summarizeBy: none
		sourceColumn: Party Key

	column GSTIN
		dataType: string
		lineageTag: 584519c4-43c8-4c91-85a3-435ccab81590
		summarizeBy: none
		sourceColumn: GSTIN

	column Amount
		dataType: double
		lineageTag: 180a2752-e354-4af6-8600-7b727d316c78
		summarizeBy: sum
		sourceColumn: Amount

	column 'Source Row'
		dataType: double
		lineageTag: e55ef8fc-aecc-4fa2-879f-12dffff3e9dd
		summarizeBy: sum
		sourceColumn: Source Row

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'GST Parties' = m
		mode: import
		source =
				let
				  Rows = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)),
				  Data = Table.FromRows(Rows, {"Month","Role","Party","Party Key","GSTIN","Amount","Source Row"}),
				  Typed = Table.TransformColumnTypes(Data, {{"Month", type nullable date},{"Role", type text},{"Party", type text},{"Party Key", type text},{"GSTIN", type text},{"Amount", type nullable number},{"Source Row", type nullable number}}, "en-US")
				in Typed

